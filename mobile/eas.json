{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HUB_BASE": "https://ruletka.vip"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_HUB_BASE": "https://ruletka.vip"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-friends": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_HUB_BASE": "https://ruletka.vip",
        "EXPO_PUBLIC_FRIENDS_ONLY": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_HUB_BASE": "https://ruletka.vip"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-friends": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_HUB_BASE": "https://ruletka.vip",
        "EXPO_PUBLIC_FRIENDS_ONLY": "1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "REPLACE_ASC_APP_ID"
      }
    }
  }
}
