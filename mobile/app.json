{
  "expo": {
    "name": "ruletka",
    "slug": "ruletka",
    "owner": "courtiers-team",
    "version": "0.1.283",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ruletka",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.ruletka.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ruletka needs the camera for peer-to-peer video chat. Video goes device-to-device and is not uploaded to our servers.",
        "NSMicrophoneUsageDescription": "ruletka needs the microphone for peer-to-peer video chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080c"
      },
      "package": "me.ruletka.app",
      "versionCode": 291,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-clipboard",
      "expo-av",
      [
        "expo-notifications",
        {
          "sounds": [],
          "icon": "./assets/icon.png",
          "color": "#ff2d55"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "hubBase": "https://ruletka.vip",
      "eas": {
        "projectId": "1e9b8ca4-2dfc-4923-84d1-138222be372f"
      }
    }
  }
}
