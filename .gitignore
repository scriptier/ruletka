# Build
/target/
**/*.rs.bk
*.o
*.so
*.dylib
*.dll
*.exe
.intentionally-empty-file.o

# Runtime / secrets (never commit)
.env
.env.*
!.env.example
data/admin.env
data/turn.env
data/*.env
data/friends.json
data/reports.jsonl
data/seeders.jsonl
data/*.jsonl
*.pem
*.key

# Prebuilt helper binaries (build or download from releases)
ui/download/roulette-bridge-*
!ui/download/*.sh
!ui/download/*.ps1
!ui/download/README.md
# Never commit bulk sideload APKs (local only; Play uses mobile/artifacts AAB)
ui/download/*.apk
ui/download/archive/
mobile/artifacts/*.apk
mobile/artifacts/*.aab
mobile/artifacts/apk-hook.log
/artifacts/
# Shelved / local-only
scripts/livekit/
/deploy/
ui/brand/_backup_*/
ui/brand/icon-source-cylinder.jpg
ui/livekit-media.js
tasks/screenshot-*.png

# Local ops / personal
phone-url.txt
phone-qr.png
*.log
.DS_Store
.idea/
.vscode/
*.swp
*~

# Brand working masters (keep compressed sources in ui/brand/, not huge intermediates)
ui/brand/*.full.mp4
ui/brand/*.prev.jpg
ui/brand/*.prev.png

# Packaged webapp staging
/webapp/dist/
/target/webapp/

# Node (if any tools added later)
node_modules/
mobile/node_modules/

# i18n machine-translation cache
ui/i18n/.mt-cache/

# Generated session brief (SessionStart / PostCompact)
.grok/session-card.txt

# Overnight admin-agent isolation + runtime noise
.admin-worktrees/
scripts/admin-agent/logs/
scripts/admin-agent/config.env
scripts/claude-logs/
tasks/admin-queue/running/
tasks/admin-queue/failed/
tasks/admin-queue/reports/
# Local pre-sleep snapshot metadata (git branches backup/* hold the real restore)
backups/
artifacts/connect-scorecard.jsonl

# Token diet. Instruction discovery skips gitignored paths.
# Search and read skip them only when tools.respect_gitignore = true
# in ~/.grok/config.toml (default is false). Project .grok/config.toml
# cannot set that key. Already tracked files stay in git.

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo
coverage/
mobile/android/**/build/
mobile/android/**/.gradle/
mobile/ios/build/
mobile/ios/Pods/

# Minified and vendor JS
**/*.min.js
**/*.min.css
**/*.bundle.js
**/*.js.map
**/*.css.map

# Images, video dumps, backups, logs, bulky data
knowledge/raw/**/*.png
knowledge/raw/**/*.jpg
knowledge/raw/**/*.jpeg
knowledge/raw/**/*.webp
knowledge/raw/**/*.gif
knowledge/raw/**/*.mp4
*.bak
*.orig
*.dump
*.sqlite
*.sqlite3
