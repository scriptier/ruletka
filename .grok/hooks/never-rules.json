{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command|Edit|Write|MultiEdit|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/pretool-never.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/session-start-agentic.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
