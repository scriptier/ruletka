#!/usr/bin/env bash
# post-commit: if this commit touched mobile app source, rebuild sideload APK
# (no --bump, so we don't dirty app.json and loop).
#
# Install once:
#   ln -sf ../../scripts/git-hooks/post-commit-apk .git/hooks/post-commit
#   # or: ./scripts/git-hooks/install-apk-hook.sh
#
# Disable for one commit: SKIP_APK_HOOK=1 git commit ...
# Disable forever: rm .git/hooks/post-commit
set -euo pipefail

[[ "${SKIP_APK_HOOK:-}" == "1" ]] && exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT"

# Only if last commit changed mobile runtime sources (not docs-only)
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^mobile/(app|src|assets|package\.json|app\.json|app\.config\.js|android/)'; then
  exit 0
fi

# Skip pure docs / scripts under mobile that don't affect the binary
if git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^mobile/' && \
   ! git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^mobile/(app/|src/|assets/|package\.json|app\.json|app\.config\.js|android/)'; then
  exit 0
fi

BUILD="$ROOT/mobile/scripts/build-apk-local.sh"
[[ -x "$BUILD" ]] || exit 0

# Shared lock with build-apk-local.sh (that script holds flock for the whole
# assemble). We only probe — do not hold across spawn (deadlock with child).
LOCK="$ROOT/mobile/artifacts/.apk-build.lock"
LOG="$ROOT/mobile/artifacts/apk-hook.log"
mkdir -p "$ROOT/mobile/artifacts"

if ! flock -n "$LOCK" -c true 2>/dev/null; then
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) skip: build already running" >>"$LOG"
  exit 0
fi
if pgrep -f 'GradleWrapperMain :app:assembleRelease' >/dev/null 2>&1; then
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) skip: gradle assemble already running" >>"$LOG"
  exit 0
fi

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) post-commit APK rebuild (no bump) HEAD=$(git rev-parse --short HEAD)" >>"$LOG"
(
  if "$BUILD" >>"$LOG" 2>&1; then
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ok" >>"$LOG"
  else
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) FAIL exit=$?" >>"$LOG"
  fi
) &
disown

echo "post-commit: APK rebuild started in background (log: mobile/artifacts/apk-hook.log)"
exit 0
