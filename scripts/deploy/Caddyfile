# HTTPS reverse proxy for ruletka.vip + ruletka.me → roulette-bridge
# Install: /etc/caddy/Caddyfile

# www → apex (SEO)
www.ruletka.vip {
	redir https://ruletka.vip{uri} permanent
}

www.ruletka.me {
	redir https://ruletka.me{uri} permanent
}

# Shared site block for both brands (same hub + pool)
ruletka.vip, ruletka.me {
	# gzip + zstd for text assets (Caddy picks best)
	encode gzip zstd

	# WebSocket match + signaling
	@ws {
		path /ws
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy 127.0.0.1:8790
	}

	# API / health / federation / ICE config — short cache / no cache
	handle /health {
		reverse_proxy 127.0.0.1:8790
		header Cache-Control "no-store"
	}
	handle /config.json {
		reverse_proxy 127.0.0.1:8790
		header Cache-Control "private, max-age=30"
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:8790
		header Cache-Control "no-store"
	}

	# Versioned static assets (live.js?v=N) — long cache; query busts deploy
	@fingerprinted {
		path *.js *.css *.woff2 *.woff *.svg *.png *.jpg *.jpeg *.webp *.webmanifest
	}
	handle @fingerprinted {
		reverse_proxy 127.0.0.1:8790
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Brand media (video loops) — medium cache
	@media {
		path /brand/*
	}
	handle @media {
		reverse_proxy 127.0.0.1:8790
		header Cache-Control "public, max-age=86400"
	}

	# HTML / rest — short cache so deploys show up without hard-fight
	handle {
		reverse_proxy 127.0.0.1:8790
		header Cache-Control "public, max-age=60, must-revalidate"
	}

	header {
		# Basic hardening
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	log {
		output file /var/log/caddy/ruletka.log
	}
}
