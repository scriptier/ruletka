# HTTPS reverse proxy for ruletka.vip → roulette-bridge
# Install: /etc/caddy/Caddyfile

# Canonical host: apex only (SEO — avoid split indexing)
www.ruletka.vip {
	redir https://ruletka.vip{uri} permanent
}

ruletka.vip {
	encode gzip zstd

	# WebSocket match + signaling
	@ws {
		path /ws
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy 127.0.0.1:8790
	}

	# API / health / federation / ICE config
	handle /health {
		reverse_proxy 127.0.0.1:8790
	}
	handle /config.json {
		reverse_proxy 127.0.0.1:8790
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:8790
	}

	# Static UI + fallback (bridge ServeDir)
	handle {
		reverse_proxy 127.0.0.1:8790
	}

	header {
		# Basic hardening
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Camera/mic for WebRTC; deny unused powerful APIs
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		# HSTS (Caddy also sets this with automatic HTTPS; keep explicit)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	log {
		output file /var/log/caddy/ruletka.log
	}
}
