# Admin agent v4 config (vibecoder factory defaults)

ROOT=
CLAUDE_TIMEOUT_SEC=1800

ENABLE_CLAUDE=1
ENABLE_AUTO_ENQUEUE=1
ENABLE_BRANCH_ISOLATION=1
ENABLE_VERIFY=1
ENABLE_ALERTS=1

# Ralph-style retry after failed verify
ENABLE_RALPH_RETRY=1
RALPH_MAX_ATTEMPTS=2

# Commit on admin/* worktree only — never push
ENABLE_AUTO_COMMIT=1

# Grok morning review (last nightly cycle + morning --with-grok)
ENABLE_GROK=1
GROK_ONLY_LAST_CYCLE=1

# NEVER flip this overnight until connect is boring-stable
ALLOW_DEPLOY=0

SSH_KEY=$HOME/.ssh/ruletka_ed25519
SSH_HOST=root@209.38.204.153
HUB_LOOKBACK_MIN=90

MAX_TASKS_PER_CYCLE=2
SLOW_OFFER_MS=5000

# ~8 hour overnight factory (Play parity queue)
NIGHTLY_INTERVAL_SEC=2700
NIGHTLY_MAX_CYCLES=10
# Stop at local hour ≥ this (13 ≈ 1pm; covers sleep + late morning)
NIGHTLY_STOP_HOUR=13

# Optional: Slack/Discord/Telegram webhook for RED
ALERT_WEBHOOK_URL=

export PATH="$HOME/.local/bin:$HOME/.config/Claude/claude-code/2.1.222:$PATH"
