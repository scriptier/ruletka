# Copy to config.env

ROOT=
CLAUDE_TIMEOUT_SEC=1800

ENABLE_CLAUDE=1
ENABLE_AUTO_ENQUEUE=1
ENABLE_BRANCH_ISOLATION=1
ENABLE_VERIFY=1
ENABLE_ALERTS=1

ENABLE_RALPH_RETRY=1
RALPH_MAX_ATTEMPTS=2
ENABLE_AUTO_COMMIT=1

ENABLE_RATE_LIMIT_BACKOFF=1
CLAUDE_RESET_LOCAL=06:30
CLAUDE_RESET_BUFFER_SEC=300

ENABLE_GROK=1
GROK_ONLY_LAST_CYCLE=1
ENABLE_GROK_MIDNIGHT_JUDGE=1
GROK_JUDGE_EVERY_N_CLAUDE=2
ENABLE_GROK_DURING_RATE_LIMIT=1
GROK_MAX_TURNS_JUDGE=15
GROK_MAX_TURNS_MANAGER=15
GROK_MAX_TURNS_MORNING=20

ALLOW_DEPLOY=0

SSH_KEY=$HOME/.ssh/ruletka_ed25519
SSH_HOST=root@209.38.204.153
HUB_LOOKBACK_MIN=90

MAX_TASKS_PER_CYCLE=2
SLOW_OFFER_MS=5000

NIGHTLY_INTERVAL_SEC=2700
NIGHTLY_MAX_CYCLES=10
NIGHTLY_STOP_HOUR=13

# Optional webhook JSON POST for RED alerts
ALERT_WEBHOOK_URL=

export PATH="$HOME/.local/bin:$HOME/.config/Claude/claude-code/2.1.222:$PATH"
