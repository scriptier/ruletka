# Copy to .env or export in your process manager. Never commit real secrets.

ROULETTE_LISTEN=0.0.0.0:8790
ROULETTE_INSTANCE_ID=my-hub
ROULETTE_PUBLIC_BASE=https://your-hub.example.com

# Comma-separated hubs advertised in GET /v1/directory (client failover hints)
ROULETTE_DIRECTORY_HUBS=https://ruletka.vip

# Federation (optional shared stranger pool — only with trusted operators)
# ROULETTE_FEDERATION_TOKEN=
# ROULETTE_FEDERATION_PEERS=https://other-hub.example.com

# Admin API for /admin.html
# ROULETTE_ADMIN_TOKEN=

# Auto-ban webhook (HTTPS only) — Telegram / Slack / Discord
# Telegram:
# ROULETTE_MOD_WEBHOOK_URL=https://api.telegram.org/botTOKEN/sendMessage?chat_id=-100123
# Slack:   https://hooks.slack.com/services/...
# Discord: https://discord.com/api/webhooks/...

# Optional public analytics (loaded by ui/analytics.js from /config.json)
# ROULETTE_YANDEX_METRICA_ID=12345678
# ROULETTE_GA_ID=G-XXXXXXXX

# Admin-editable directory hubs also persist to data/directory_hubs.json
# ROULETTE_DIRECTORY_FILE=data/directory_hubs.json

# Mobile Universal Links / App Links (optional; after store signing)
# ROULETTE_IOS_TEAM_ID=          # Apple Team ID (10 chars)
# ROULETTE_IOS_BUNDLE_ID=vip.ruletka.app
# ROULETTE_ANDROID_SHA256=       # Play signing cert fingerprint AA:BB:...
# ROULETTE_ANDROID_PACKAGE=vip.ruletka.app

# TURN (prefer self-hosted coturn + secret)
# ROULETTE_TURN=turn:your-hub.example.com:3478
# ROULETTE_TURN_SECRET=
# ROULETTE_TURN_TTL=21600
# ROULETTE_OPEN_TURN=false
